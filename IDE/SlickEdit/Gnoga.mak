COMPILE=gnat -O -c $(CFG_INC) -o "$(OUTDIR)/$(*F).o" "$<"
LINK=gnat -O -o "$(OUTFILE)" $(OBJ) $(CFG_LIB)
COMPILE_ADA=gnat -O -c -o "$(OUTDIR)/$(*F).o" "$<"
COMPILE_ADB=gnat -O -c -o "$(OUTDIR)/$(*F).o" "$<"

