            Name="Source Files"
            Filters="*.ada;*.adb;*.c;*.cpp"
            GUID="{6F647231-F309-4ED9-AD15-1B830280E246}"/>
        <Folder
            Name="Header Files"
            Filters="*.h;*.ads"
            GUID="{745722E3-39F4-4291-80B2-3D5BA2EF9641}"/>
