with "ada_lib.gpr";
--with "ada_lib_test_lib.gpr";
with "gnoga_ada_lib.gpr";
with "alr_environment.gpr";
with "aunit.gpr";
with "config/ada_lib_tests_config.gpr";
--with "gnatcoll_minimal.gpr";
with "gnoga.gpr";
--with "xmlada";

project Ada_Lib_Tests is
   for Source_Dirs use ("src/");
   for Object_Dir use "obj/" & Alr_Environment.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("test_ada_lib.adb");
   for Library_Dir use "lib/" & ALR_Environment.Build_Mode;

   package Compiler is
      for Default_Switches ("Ada") use
         Alr_Environment.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use
         Alr_Environment.Ada_Binder_Switches;
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use ALR_Environment.Linker_Options;
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Builder is
      case ALR_Environment.Build_Mode is

         when "aunit" | "execute" =>
            for Executable ("test_ada_lib.adb") use "test_ada_lib";

         when "help_test" =>
            for Executable ("test_ada_lib.adb") use "help_test";

      end case;
   end Builder;

end Ada_Lib_Tests;
