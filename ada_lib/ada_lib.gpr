with "ada_lib_aunit.gpr";
with "ada_lib_base.gpr";
with "ada_lib_options.gpr";
with "alr_environment.gpr";
with "aunit.gpr";
with "gnoga.gpr";
with "gnoga_ada_lib.gpr";
with "gnatcoll_minimal.gpr";

project Ada_Lib is

   for Library_Name use "Ada_Lib";
   for Library_Version use Project'Library_Name & ".so." &
       Alr_Environment.Crate_Version;
   Ada_OS_Include:= external ("ADA_OS_INCLUDE");

   for Source_Dirs use ("src/", "../src", "src/unit_test");
   for Object_Dir use "obj/" & Alr_Environment.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib/" & ALR_Environment.Build_Mode;

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("ADA_LIB_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
         Alr_Environment.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Ada_Lib;
